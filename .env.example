# Mint RedCeh environment — copy to .env or export in the shell.

# --- Walrus Memory (MemWal) — set BOTH to leave dry mode -------------------
# Delegate private key for the MemWal account (hex / suiprivkey). Server-side
# only: never commit it, never paste it in chat.
MEMWAL_KEY=
# MemWal account object ID on Sui mainnet.
MEMWAL_ACCOUNT_ID=
# Namespace for this app's memories (default: mintredceh).
MEMWAL_NAMESPACE=mintredceh

# --- Tatum -----------------------------------------------------------------
# Optional: basic Sui GraphQL reads work keyless; set a key to use the
# documented flow. (A free dashboard.tatum.io account is still needed for
# the hackathon submission form's Account_ID.)
TATUM_API_KEY=

# --- Server ----------------------------------------------------------------
PORT=8787
# Optional: when set, POST /api/observe requires this value in the
# x-observe-token header. Leave unset for local/demo use.
OBSERVE_TOKEN=
